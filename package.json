{
  "name": "palette_3d_viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "next build",
    "check": "eslint . && tsc --noEmit",
    "corpus:rob": "bun run src/lib/parity/cli.node.ts",
    "corpus:rob:sentinel": "bun run src/lib/parity/sentinelCli.node.ts",
    "db:down": "${CONTAINER_ENGINE:-docker} compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/db-migrate.ts",
    "db:up": "${CONTAINER_ENGINE:-docker} compose up -d db",
    "dev": "next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,md,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,md,mdx}\" --cache",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "node scripts/copy-ort-wasm.mjs",
    "preview": "next build && next start",
    "sheet:eval": "bun run src/lib/sheetExtraction/evalCli.node.ts",
    "stack:down": "${CONTAINER_ENGINE:-docker} compose down",
    "stack:up": "${CONTAINER_ENGINE:-docker} compose up -d --build",
    "start": "next start",
    "test": "vitest",
    "test:corpus": "vitest run src/lib/parity/externalCorpus.node.test.ts",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@t3-oss/env-nextjs": "^0.12.0",
    "drizzle-orm": "^0.45.4",
    "next": "15.5.21",
    "onnxruntime-web": "1.31.1",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.0.15",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.14.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.23.0",
    "eslint-config-next": "15.5.21",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.15",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "ct3aMetadata": {
    "initVersion": "7.39.3"
  }
}
