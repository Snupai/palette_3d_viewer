# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Example:
# SERVERVAR="foo"
# NEXT_PUBLIC_CLIENTVAR="bar"

# Deploy without AI: hides the sheet-photo import and disables
# /api/sheet-extraction. Read at build time ("true" or "1").
# NEXT_PUBLIC_DISABLE_AI_FEATURES="true"

# Local vision model that reads photographed pallet sheets (never a cloud API).
# /api/sheet-extraction has no auth: expose it only on the line network or
# behind an authenticating, rate-limiting proxy (see README).
# "ollama" (default, /api/chat) or "openai" (OpenAI-compatible
# /v1/chat/completions, e.g. llama.cpp `llama-server --mmproj …`).
# SHEET_EXTRACTION_API="ollama"
# Base URL; defaults to http://127.0.0.1:11434 (ollama) / :8080 (openai).
# OLLAMA_URL is still read when this is unset.
# SHEET_EXTRACTION_URL="http://127.0.0.1:11434"
# Required name for Ollama (default qwen2.5vl:32b); optional for "openai" with a
# single-model `llama-server -m …`, required in its router/multi-model mode.
# SHEET_EXTRACTION_MODEL="qwen2.5vl:32b"
# Optional, sent as "Authorization: Bearer <key>" (llama-server --api-key).
# SHEET_EXTRACTION_API_KEY=""
# Concurrent sheet-extraction inferences per process (others get HTTP 429).
# SHEET_EXTRACTION_MAX_CONCURRENT="1"

# Storage mode (ADR 0002): "local" (default) keeps plans in the browser's
# IndexedDB; "server" uses the LAN server. There is no automatic fallback.
# Read at build time.
# NEXT_PUBLIC_PALETTE_STORAGE_MODE="local"
# PostgreSQL connection URL, server mode only (ADR 0009). Matches the
# container defaults; never point it at a database reachable from the plant network.
# DATABASE_URL="postgresql://palette:palette@127.0.0.1:5432/palette"

# Enable only behind a trusted proxy that overwrites X-Forwarded-For with one IP
# and prevents direct client access to the app (see docs/DEPLOYMENT.md).
# PALETTE_LOGIN_TRUST_PROXY="false"
